import math
from collections import Counter

def countGoodIntegers(n: int, k: int):
    good_multisets = set()
    m = (n + 1) // 2
    
    # The first m digits form a number X from 10^(m-1) to 10^m - 1
    # Special case for n=1: m=1, range is 1 to 9.
    start = 10**(m-1) if m > 0 else 0 # but m is always >= 1 since n >= 1
    if n == 1:
        # For n=1, the palindrome is just a single digit from 1 to 9
        for x in range(1, 10):
            s = str(x)
            p_int = int(s)
            if p_int % k == 0:
                good_multisets.add(tuple(sorted(list(s))))
    else:
        for x in range(start, 10**m):
            s = str(x)
            if n % 2 == 0:
                p = s + s[::-1]
            else:
                p = s + s[:-1][::-1]
            
            p_int = int(p)
            if p_int % k == 0:
                good_multisets.add(tuple(sorted(list(p))))

    total_count = 0
    for multiset in good_multisets:
        counts = Counter(multiset)
        # Total permutations of the multiset
        denom = 1
        for c in counts.values():
            denom *= math.factorial(c)
        total_perms = math.factorial(n) // denom
        
        # Permutations starting with zero
        zero_count = counts.get('0', 0)
        if zero_count > 0:
            # Number of permutations where the first digit is '0'
            # This means we have (n-1) positions left and one fewer '0'
            # The remaining digits are (c0-1, c1, ..., c9)
            denom_zero = 1
            for char, c in counts.items():
                if char == '0':
                    denom_zero *= math.factorial(c - 1)
                else:
                    denom_zero *= math.factorial(c)
            total_perms_with_zero = math.factorial(n - 1) // denom_zero
        else:
            total_perms_with_zero = 0
            
        total_count += (total_perms - total_perms_with_zero)
        
    return total_count

```

