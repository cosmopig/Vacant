from math import factorial

def countGoodIntegers(n: int, k: int) -> int:
    def get_multiset(num_str):
        counts = [0] * 10
        for char in num_str:
            counts[int(char)] += 1
        return tuple(counts)

    def count_permutations(counts, n):
        denom = 1
        for c in counts:
            if c > 1:
                denom *= factorial(c)
        
        total = factorial(n) // denom
        
        if counts[0] > 0:
            return total - (total * counts[0] // n)
        else:
            return total

    unique_multisets = set()
    m = (n + 1) // 2
    start = 10**(m - 1)
    end = 10**m
    
    for i in range(start, end):
        s = str(i)
        if n % 2 == 0:
            p_str = s + s[::-1]
        else:
            p_str = s + s[:-1][::-1]
        
        if int(p_str) % k == 0:
            unique_multisets.add(get_multiset(p_str))
            
    total_good_integers = 0
    for ms in unique_multisets:
        total_good_integers += count_permutations(ms, n)
        
    return total_good_integers
