import os
from pathlib import Path
import pandas as pd
import docx

def task_func(source_directory: str, target_directory: str) -> int:
    if not os.path.isdir(source_directory):
        raise FileNotFoundError(f"Source directory {source_directory} does not exist.")
    
    target_path = Path(target_directory)
    target_path.mkdir(parents=True, exist_ok=True)

    count = 0
    for file_path in Path(source_directory).iterdir():
        if file_path.is_file():
            ext = file_path.suffix.lower()
            if ext in ['.txt', '.docx', '.xlsx', '.csv']:
                try:
                    text_content = ""
                    if ext == '.txt':
                        text_content = file_path.read_text(encoding='utf-8')
                    elif ext == '.docx':
                        doc = docx.Document(file_path)
                        text_content = "\n".join([para.text for para in doc.paragraphs])
                    elif ext == '.xlsx':
                        df = pd.read_excel(file_path)
                        text_content = df.to_string()
                    elif ext == '.csv':
                        # Read as text to capture all content including headers/delimiters
                        text_content = file_path.read_text(encoding='utf-8')
                    
                    target_filename = file_path.stem + ".csv"
                    target_file_path = target_path / target_filename
                    
                    df_out = pd.DataFrame({'Text': [text_content]})
                    df_out.to_csv(target_file_path, index=False)
                    count += 1
                except Exception:
                    continue
    return count
