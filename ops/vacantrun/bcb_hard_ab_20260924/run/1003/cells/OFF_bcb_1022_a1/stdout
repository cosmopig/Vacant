The task requires reading a CSV file, validating its existence and columns, converting dates, filtering by the current date (keeping today and future dates), and sorting the results. I have implemented this in `solution.py` following all instructions from `goal.md` and `contract.md`.

```python
import pandas as pd
import os
from datetime import datetime
from pandas.errors import EmptyDataError

def task_func(csv_file_path, column_name, date_format="%Y-%m-%d"):
    """
    Reads a CSV file and processes its date-related data.
    Checks for the file's existence, validates the presence of a specified date column,
    converts date values to datetime objects, filters rows based on the current date (today or future),
    and sorts the resulting data by the date column.
    """
    if not os.path.exists(csv_file_path):
        raise FileNotFoundError(f"File not found: {csv_file_path}")

    try:
        df = pd.read_csv(csv_file_path)
    except EmptyDataError:
        return pd.DataFrame()

    if column_name not in df.columns:
        raise ValueError(f"Column '{column_name}' not found in CSV file.")

    # Convert the specified column to datetime objects using the provided format
    df[column_name] = pd.to_datetime(df[column_name], format=date_format)

    # Filtering rows based on the current date (keeping today and future dates)
    today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
    df = df[df[column_name] >= today]

    # Sorting the resulting data by the date column in ascending order
    df = df.sort_values(by=column_name)

    return df
