```python
import numpy as np
import matplotlib.pyplot as plt
import re
from collections import Counter

def task_func(mystrings, text):
    if not text:
        raise ValueError("If the input text is empty.")
    
    # We will use a list of characters to build the result
    result = list(text)
    # A mask to keep track of which characters are already "consumed" by a match
    consumed = [False] * len(text)
    
    # Sort mystrings by length descending to handle nested cases correctly.
    sorted_targets = sorted(myststrings, key=len, reverse=True)
    
    for s in sorted_targets:
        s_lower = s.lower()
        if not s_lower: continue
        
        start = 0
        while True:
            idx = text.lower().find(s_lower, start)
            if idx == -1:
                break
            
            # Check if this match is already consumed
            is_consumed = False
            for i in range(idx, idx + len(s_lower)):
                if consumed[i]:
                    is_consumed = True
                    break
            
            if not is_consumed:
                # This is a new match. 
                # Replace spaces with underscores and lowercase the whole match.
                for i in range(idx, idx + len(s_lower)):
                    if text[i] == ' ':
                        result[i] = '_'
                    else:
                        result[i] = text[i].lower()
                    consumed[i] = True
            
            start = idx + 1
            
    final_text = "".join(result)
    # Now split by spaces to get words.
    words_to_plot = final_text.split(' ')
    
    counts = Counter()
    unique_order = []
    for w in words_to_plot:
        if not w: continue # handle multiple spaces if any
        if w not in counts:
            unique_order.append(w)
            counts[w] = 1
        else:
            counts[w] += 1
            
    plt.figure()
    # The goal says "The frequency plot displays each unique word on the x-axis 
    # in the order they appear after modification with its corresponding frequency on the y-axis."
    plt.plot(unique_order, [counts[w] for w in unique_order])
    return plt.gca()
```

