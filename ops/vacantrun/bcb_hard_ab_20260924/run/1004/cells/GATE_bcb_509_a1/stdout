from difflib import ndiff
def task_func(file_path1, file_path2, delimiter=',', quotechar='"'):
    try:
        with open(file_path1, 'r', encoding='utf-8') as f1:
            lines1 = f1.readlines()
        with open(file_path2, 'r', encoding='utf-8') as f2:
            lines2 = f2.readlines()

        if not lines1 or not lines2:
            raise ValueError("One or both files are empty.")

        diff = list(ndiff(lines1, lines2))
        
        results = []
        current_line_num = 1
        for line in diff:
            status = line[0]
            if status == '?':
                continue
            content_raw = line[2:]
            
            parsed_row = []
            if content_raw.strip():
                reader = csv.reader([content_raw], delimiter=delimiter, quotechar=quotechar)
                try:
                    parsed_row = next(reader)
                except StopIteration:
                    parsed_row = []
            else:
                parsed_row = []

            results.append({
                'Line Number': current_line_num,
                'Status': status,
                'Content': str(tuple(parsed_row))
            })
            current_line_num += 1

        df = pd.DataFrame(results)
        return df

    except FileNotFoundError as e:
        raise e
    except ValueError as e:
        raise e
    except Exception as e:
        raise e
