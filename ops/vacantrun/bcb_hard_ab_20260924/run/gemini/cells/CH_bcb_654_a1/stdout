import matplotlib.pyplot as plt
import scipy.optimize as optimize
import numpy as np

def task_func(array, target_value):
    array = np.array(array)
    
    # Find indices where the first column matches target_value
    # The array may contain mixed types, so we compare elements.
    # array[:, 0] == target_value works for most cases.
    indices = np.where(array[:, 0] == target_value)[0]
    
    if len(indices) < 3:
        raise ValueError("Not enough points for fitting.")
    
    x = indices.astype(float)
    
    # Get y-values from the second column.
    # If the array has only one column, this will raise an IndexError.
    try:
        y = array[indices, 1].astype(float)
    except (IndexError, ValueError):
        raise ValueError("Not enough points or invalid data for fitting.")

    # Exponential decay function: y = a * exp(-b * x) + c
    def func(x, a, b, c):
        return a * np.exp(-b * x) + c

    # Perform the curve fit
    popt, _ = optimize.curve_fit(func, x, y)
    
    # Create the plot and the Axes object
    fig, ax = plt.subplots()
    ax.scatter(x, y)
    
    # Optional: plot the fitted curve
    x_fit = np.linspace(x.min(), x.max(), 100)
    y_fit = func(x_fit, *popt)
    ax.plot(x_fit, y_fit)
    
    return popt, ax
