diff -ruN a/tools/waitcheck.mjs b/tools/waitcheck.mjs
--- a/tools/waitcheck.mjs	1970-01-01 08:00:00
+++ b/tools/waitcheck.mjs	2026-09-21 11:38:43
@@ -0,0 +1,334 @@
+// 等待態（「給等待一個形狀」）的可執行判準。
+//
+// 為什麼要這一支而不是加進 `tools/livecheck.mjs`：2026-09-21 同一天有十幾個
+// 代理在改同一個 repo，`livecheck.mjs` 這一輪剛被動過（L38／L39）。
+// 一個新檔案＝零合併衝突，而判準一條都不少。
+//
+// 這裡測的是**畫面會說哪一句話、那團東西會不會停**，不是「碼長什麼樣子」：
+//   - `formingLevel` 是**漸近**的 ⇒ 它永遠不會自己走到完成（不是進度條）
+//   - `waitPulse` 在第 900 秒**照樣在跳** ⇒ 等再久畫面都不是凍住的
+//   - 退化的措辭**逐字等於** `twinEngineNote` ⇒ 兩處措辭不會漂
+//   - 等待態的任何一句話裡**不含觀眾打的原文** ⇒ §5.1-2／§5.1-9
+//
+// 用法（node ≥ 18）：node tools/waitcheck.mjs
+import fs from "node:fs";
+import path from "node:path";
+import url from "node:url";
+import vm from "node:vm";
+
+const HERE = path.dirname(url.fileURLToPath(import.meta.url));
+const ROOT = path.resolve(HERE, "..");
+const PAGE = path.join(ROOT, "world3/index.html");
+
+let fail = 0, ran = 0;
+const check = (name, ok, extra = "") => {
+  ran++;
+  console.log(`[${ok ? "OK    " : "BROKEN"}] ${name}${extra ? "  " + extra : ""}`);
+  if (!ok) fail++;
+};
+
+// 🔴 這道閘門自己的負控制（理由與 livecheck.mjs 同一條：一把沒有實際掃過
+//    它要掃的那條路的尺，不該回報通過）。
+const MIN_CHECKS = 30;
+
+/* ---- 抽出 LIVE 區段（等待態的判斷全在裡面）---------------------------- */
+const html = fs.readFileSync(PAGE, "utf8");
+const i = html.indexOf("/* === LIVE-BEGIN ===");
+const j = html.indexOf("/* === LIVE-END === */");
+if (i < 0 || j < 0) { console.error("找不到 LIVE-BEGIN／LIVE-END"); process.exit(2); }
+const src = html.slice(i, j);
+
+const ctx = { JSON, Math, Number, Array, Object, String, Set, Map, console,
+              Boolean, isFinite };
+vm.createContext(ctx);
+vm.runInContext(
+  src + "\n;globalThis.__api={TWIN_WAIT,twinPending,formingLevel,waitPulse,waitSeed,"
+  + "waitPhase,humanDuration,waitEngineBadge,waitDegraded,waitCaption,"
+  + "waitArrivalCaption,waitLateCaption,twinEngineNote,visitorLabel,"
+  + "visitorCode,visitorCategory};", ctx);
+const A = ctx.__api;
+const C = A.TWIN_WAIT;
+console.log(`抽出 LIVE 區段 ${src.length} 字元`);
+
+/* 觀眾打的原話（測資）。**任何一句畫面文字裡都不准出現。** */
+const RAW_NEED = "幫我把公司報價單的 Excel 整理成一頁摘要";
+const RAW_FIRST = "我是做建材批發的，客戶老是問我同樣的問題";
+const CARD = { need: RAW_NEED, first_line: RAW_FIRST, firstline: RAW_FIRST,
+               shape: "圓潤", color: "暖土", texture: "粗陶" };
+const ID = "2e66a0ed-5858-43c8-bcb2-83c6d7f99c6d";
+
+const subPending  = { id: ID, card: CARD, twin: { arrival: null, working: null,
+                      handover: null, engine: null, status: "submitted" } };
+const subReal     = { id: ID, card: CARD, twin: { arrival: "我到了", working: "我在做",
+                      handover: "交給你", engine: "lmstudio:gemma-4-12b-it-qat",
+                      status: "generated" } };
+const subFallback = { id: ID, card: CARD, twin: { arrival: "我到了", working: "我在做",
+                      handover: "交給你", engine: "fallback_deterministic",
+                      status: "generated" } };
+const subNoEngine = { id: ID, card: CARD, twin: { arrival: "我到了", working: null,
+                      handover: null, engine: null, status: "generated" } };
+const subNoTwin   = { id: ID, card: CARD };
+
+/* ═══ W1 三值：不知道就說不知道 ═════════════════════════════════ */
+check("W1a 還沒生 ⇒ twinPending true", A.twinPending(subPending) === true);
+check("W1b 生好了 ⇒ twinPending false", A.twinPending(subReal) === false);
+check("W1c 有三句話就算好了（status 缺也認）",
+      A.twinPending({ id: ID, card: CARD, twin: { arrival: "我到了", status: null } }) === false);
+check("W1d 沒帶 twin ⇒ null（不是 false，也不是 true）",
+      A.twinPending(subNoTwin) === null);
+check("W1e 有 twin 但整包都是 null ⇒ null（沒量到不猜）",
+      A.twinPending({ id: ID, card: CARD, twin: { arrival: null, working: null,
+        handover: null, engine: null, status: null } }) === null);
+check("W1f 不認得的 status ⇒ null（不當成好了）",
+      A.twinPending({ id: ID, card: CARD, twin: { status: "銀河系" } }) === null);
+
+/* ═══ W2 這不是進度條：成形曲線漸近，永遠不自己完成 ═════════════ */
+{
+  const l0 = A.formingLevel(0, C), l30 = A.formingLevel(30, C);
+  const l300 = A.formingLevel(300, C), lInf = A.formingLevel(1e9, C);
+  check("W2a t=0 沒有成形", l0 === 0);
+  check("W2b 單調上升", l30 > l0 && l300 > l30 && lInf >= l300);
+  check("W2c 🔴 永遠到不了 1（不是進度條）", lInf < 1 && lInf < 1 - 1e-9,
+        `lim=${lInf.toFixed(6)}`);
+  // ⚠ 這一條刻意**不**寫成「連 ceil 都到不了」：`1 - e^(-t/τ)` 在 t≳950 秒
+  //   就會在 double 精度下等於 1（`1 - 1e-17 === 1`），那個「嚴格小於」是數學
+  //   上的事實、不是可觀測的差別。可觀測的差別是**永遠差 1 一大截**：
+  //   畫面上那個人**看得出來還沒成形**（殘餘 ≥ 5%），所以「完成」只可能由
+  //   `director.twinArrived` 造成，不可能由時間造成。
+  check("W2d 🔴 上限離完成還差看得見的一截（殘餘 ≥ 5%）",
+        lInf <= C.ceil && 1 - lInf >= 0.05, `殘餘=${(1 - lInf).toFixed(3)}`);
+  check("W2d2 在實際會發生的時間窗內（≤300 秒）都還沒碰到上限",
+        A.formingLevel(300, C) < C.ceil);
+  check("W2e 上限本身就 <1（寫死一個 1 進去就是進度條）", C.ceil < 1);
+  // 負控制：把曲線換成線性進度條，上面兩條必須抓到
+  const bar = (t) => Math.min(1, t / 300);
+  check("W2f 負控制：線性進度條會在 t=300 走到 1，判準抓得到",
+        bar(300) === 1 && !(bar(1e9) < 1));
+  check("W2g 負控制：`ceil=1` 的漸近曲線也算進度條（會宣稱完成）",
+        !(1 * (1 - Math.exp(-1e9 / C.tauS)) < 1));
+}
+
+/* ═══ W3 「沒有凍住」是可執行的：心跳在第 900 秒照樣在跳 ══════════ */
+{
+  const seed = A.waitSeed(ID);
+  const sample = (t0) => {
+    const v = [];
+    for (let k = 0; k < 240; k++) v.push(A.waitPulse(t0 + k / 24, seed));
+    return { lo: Math.min(...v), hi: Math.max(...v) };
+  };
+  const a = sample(3), b = sample(900), c = sample(3600);
+  check("W3a 開場十秒內心跳有高有低", a.hi - a.lo > 0.5, `Δ=${(a.hi - a.lo).toFixed(3)}`);
+  check("W3b 🔴 第 900 秒（退役門檻）心跳照樣在跳", b.hi - b.lo > 0.5,
+        `Δ=${(b.hi - b.lo).toFixed(3)}`);
+  check("W3c 🔴 第 3600 秒也還在跳（沒有任何衰減項）", c.hi - c.lo > 0.5,
+        `Δ=${(c.hi - c.lo).toFixed(3)}`);
+  check("W3d 心跳有回到低點（不是一直亮著）", b.lo < 0.15, `lo=${b.lo.toFixed(3)}`);
+  // 負控制：一個「會凍住」的實作（跟成形程度綁在一起）必須被抓到
+  const frozen = (t) => A.formingLevel(t, C);
+  const fz = [];
+  for (let k = 0; k < 240; k++) fz.push(frozen(900 + k / 24));
+  check("W3e 負控制：把脈動綁成形程度 ⇒ 900 秒後幾乎不動，判準抓得到",
+        Math.max(...fz) - Math.min(...fz) < 0.01);
+  check("W3f 兩位同時在等的人不同步（相位吃各自的 id）",
+        A.waitPulse(5, A.waitSeed("aaa")) !== A.waitPulse(5, A.waitSeed("bbb")));
+  check("W3g waitSeed 確定性", A.waitSeed(ID) === A.waitSeed(ID) && A.waitSeed(ID) >= 0);
+}
+
+/* ═══ W4 階段 ═══════════════════════════════════════════════════ */
+check("W4a 剛開始＝forming", A.waitPhase(1, C) === "forming");
+check("W4b 超過實測上限兩倍＝long", A.waitPhase(C.longS + 1, C) === "long");
+check("W4c 到門檻＝retiring", A.waitPhase(C.retireS + 1, C) === "retiring");
+check("W4d 儀式演完＝retired",
+      A.waitPhase(C.retireS + C.ceremonyS + 1, C) === "retired");
+check("W4e longS 真的超過實測最大值（不是隨手寫的）", C.longS > C.obsMaxS);
+{
+  // 🔴 迴歸：現場調校把 `?waitretire=` 調到 `longS` 以下的時候，**退役還是要發生**。
+  //    第一版由前往後判階段 ⇒ 那個情況下退役永遠不觸發（實測 45 秒還是 forming，
+  //    儀式一次都沒演）。這一條就是那次的迴歸測。
+  const tuned = { ...C, retireS: 34, ceremonyS: 9 };   // longS 仍是 108
+  check("W4e2 🔴 retireS 被調到 longS 以下，退役照樣發生",
+        A.waitPhase(35, tuned) === "retiring"
+        && A.waitPhase(50, tuned) === "retired",
+        `35s=${A.waitPhase(35, tuned)} 50s=${A.waitPhase(50, tuned)}`);
+  check("W4e3 負控制：由前往後判的舊寫法在同一組參數下會答錯",
+        (35 < tuned.longS ? "forming" : "x") === "forming");
+}
+check("W4f retireS 遠大於實測最大值（不會把正常的一次判成走掉）",
+      C.retireS > C.obsMaxS * 5);
+
+/* ═══ W5 時間講法：沒量到不編一個 0 ═════════════════════════════ */
+check("W5a null 進 null 出（不寫 0 秒）", A.humanDuration(null) === null);
+check("W5b 未定義也回 null", A.humanDuration(undefined) === null);
+check("W5c 秒", A.humanDuration(12000) === "12 秒");
+check("W5d 分秒", A.humanDuration(72000) === "1 分 12 秒");
+check("W5e 整分不補 0 秒", A.humanDuration(120000) === "2 分");
+
+/* ═══ W6 退化：措辭逐字等於 twinEngineNote，不是第二份 ═══════════ */
+check("W6a 退化那一句逐字相同",
+      A.waitEngineBadge(subFallback) === A.twinEngineNote(subFallback)
+      && A.waitEngineBadge(subFallback) === "⚠ 他說的話是查表湊的，這一次沒有模型參與");
+check("W6b 真模型那一句也逐字相同",
+      A.waitEngineBadge(subReal) === A.twinEngineNote(subReal));
+check("W6c 沒帶 engine ⇒ 不掛（null）", A.waitEngineBadge(subNoEngine) === null);
+check("W6d waitDegraded 三值 true", A.waitDegraded(subFallback) === true);
+check("W6e waitDegraded 三值 false", A.waitDegraded(subReal) === false);
+check("W6f waitDegraded 三值 null（沒帶 engine 不猜）",
+      A.waitDegraded(subNoEngine) === null);
+{
+  const real = A.waitArrivalCaption(subReal, ID);
+  const deg = A.waitArrivalCaption(subFallback, ID);
+  const unk = A.waitArrivalCaption(subNoEngine, ID);
+  check("W6g 🔴 退化與真模型的大字**不一樣**（畫面上分得出來）",
+        real.head !== deg.head && deg.head.indexOf("沒有模型參與") >= 0);
+  check("W6h 退化的副標就是 twinEngineNote 原句",
+        deg.sub === A.twinEngineNote(subFallback));
+  check("W6i 沒標 engine 的那一筆不冒充真模型",
+        unk.tone === "warn" && unk.sub.indexOf("沒有標") >= 0);
+  check("W6j 真模型那一筆才是 good", real.tone === "good");
+}
+
+/* ═══ W7 等待態的每一句話都不含觀眾原文 ═════════════════════════ */
+{
+  const texts = [];
+  for (const reach of [true, false, null]){
+    for (const ms of [0, 5000, 60000, C.longS * 1000 + 1000,
+                      C.retireS * 1000 + 1000]){
+      const c = A.waitCaption(subPending, ID, ms, C, reach);
+      texts.push(c.head, c.sub);
+    }
+  }
+  texts.push(A.waitArrivalCaption(subReal, ID).head,
+             A.waitArrivalCaption(subReal, ID).sub,
+             A.waitArrivalCaption(subFallback, ID).head,
+             A.waitLateCaption(subReal, ID));
+  const joined = texts.filter(Boolean).join(" | ");
+  check("W7a 🔴 沒有任何一句話含觀眾打的 need 原文",
+        joined.indexOf(RAW_NEED) < 0 && joined.indexOf("報價單") < 0);
+  check("W7b 🔴 沒有任何一句話含 first_line 原文",
+        joined.indexOf(RAW_FIRST) < 0 && joined.indexOf("建材") < 0);
+  // ⚠ 大標只放代號（`visitorCode`）：1920×1080 實拍證實整串 `visitorLabel`
+  //   會爆出畫面。類別改印在他腳邊那一行（`visitorCategory`，繪圖層）。
+  check("W7c 大標印的是代號（visitorCode）",
+        joined.indexOf(A.visitorCode(ID)) >= 0, A.visitorCode(ID));
+  check("W7c2 類別本身也是從同一組 shape/color/texture 來的，沒另造一套",
+        A.visitorCategory(CARD) === "圓潤／暖土／粗陶");
+  check("W7c3 代號＋類別合起來仍然還原不出原文",
+        (A.visitorCode(ID) + A.visitorCategory(CARD)).indexOf(RAW_NEED) < 0);
+  // 負控制：把原文塞進 caption，掃描必須抓到
+  const poisoned = joined + " | 他帶著一件事來：" + RAW_NEED;
+  check("W7d 負控制：原文塞進去，同一套掃描抓得到",
+        poisoned.indexOf(RAW_NEED) >= 0);
+}
+
+/* ═══ W8 字幕本身：讀不到要講、等太久要講、退役要講 ═════════════ */
+{
+  const now = A.waitCaption(subPending, ID, 12000, C, true);
+  const lost = A.waitCaption(subPending, ID, 12000, C, false);
+  const long = A.waitCaption(subPending, ID, (C.longS + 5) * 1000, C, true);
+  const ret = A.waitCaption(subPending, ID, (C.retireS + 1) * 1000, C, true);
+  check("W8a 一般：講「已經多久」＋「我們量過的是多久」",
+        now.sub.indexOf("已經 12 秒") >= 0
+        && now.sub.indexOf(`${C.obsMinS} 到 ${C.obsMaxS} 秒`) >= 0, now.sub);
+  check("W8b 🔴 讀不到要蓋過時間那一句", lost.sub.indexOf("⚠") === 0
+        && lost.sub.indexOf("讀不到") >= 0, lost.sub);
+  check("W8c 超過量過的範圍要直說", long.sub.indexOf("⚠") >= 0
+        && long.sub.indexOf("比我們量過的最久") >= 0, long.sub);
+  check("W8d 退役講「回到土堆」而且不宣稱刪掉",
+        ret.head.indexOf("沒有成形") >= 0
+        && ret.sub.indexOf("土堆") >= 0
+        && ret.sub.indexOf("刪") < 0, ret.sub);
+  check("W8e 退役那一句沒有宣稱「已完成」",
+        ret.sub.indexOf("完成") >= 0 && ret.sub.indexOf("沒有被演成完成") >= 0);
+  check("W8f 沒量到 elapsed 也不編一個秒數",
+        A.waitCaption(subPending, ID, null, C, true).sub.indexOf("已經") < 0);
+  check("W8g 後來才成形的那一位有自己的一句",
+        A.waitLateCaption(subReal, ID).indexOf("後來還是成形了") >= 0);
+}
+
+/* ═══ W9 螢幕上的數字要有出處 ═══════════════════════════════════ */
+check("W9a 實測帶：min ≤ med ≤ max",
+      C.obsMinS <= C.obsMedS && C.obsMedS <= C.obsMaxS);
+check("W9b 出處欄位不是空的", typeof C.obsSrc === "string" && C.obsSrc.length > 8);
+check("W9c n 是真的樣本數", C.obsN === 7);
+{
+  // 🔴 派工單上那兩個查不到出處的數字，**不准出現在畫面文字裡**。
+  const all = [];
+  for (const ms of [0, 30000, 400000, 800000]) {
+    const c = A.waitCaption(subPending, ID, ms, C, true);
+    all.push(c.head, c.sub);
+  }
+  const s = all.filter(Boolean).join(" ");
+  check("W9d 🔴 畫面上沒有「312」也沒有「727」（兩個 repo 都查不到出處）",
+        s.indexOf("312") < 0 && s.indexOf("727") < 0, s.slice(0, 60) + "…");
+}
+
+/* ═══ W10 掃描原始碼：等待態沒有偷印原文、也沒有偷偷畫進度條 ════ */
+{
+  const wi = html.indexOf("等待態的畫面：一團**屬於他的**黏土");
+  const wj = html.indexOf("/* ── 導演（重放＋訪客流程都走電影場景切換）");
+  const draw = wi >= 0 && wj > wi ? html.slice(wi, wj) : "";
+  check("W10a 抽得到繪圖那一段", draw.length > 2000, `${draw.length} 字元`);
+  check("W10b 🔴 繪圖段沒有碰 card.need／first_line",
+        draw.indexOf("card.need") < 0 && draw.indexOf("first_line") < 0
+        && draw.indexOf("firstline") < 0);
+  check("W10c 🔴 繪圖段沒有畫長條（fillRect 寬度綁成形程度那種）",
+        !/fillRect\([^)]*lv/.test(draw));
+  check("W10d 繪圖段確實用了漸近曲線與心跳",
+        draw.indexOf("formingLevel(") >= 0 && draw.indexOf("waitPulse(") >= 0);
+  check("W10e 退化走另一組色票（cool／去飽和）",
+        draw.indexOf("shaft_cool_v") >= 0 && draw.indexOf("degraded") >= 0);
+  // 負控制：把一根進度條塞進那一段，掃描必須抓到
+  const poisonedDraw = draw + "\ncx.fillRect(x0, y0, 200*lv, 8);";
+  check("W10f 負控制：塞一根進度條進去，掃描抓得到",
+        /fillRect\([^)]*lv/.test(poisonedDraw));
+}
+
+/* ═══ W11 退化那張字卡真的會出現在**產品路徑**上 ══════════════════
+   🔴 這一組是 2026-09-21 用真的來源鏈（靜態快照 → `bridge.js` → `waitResolverTick`）
+      錄影才抓到的：`waitResolverTick` 只翻了 `cur.degraded` 旗標與顏色，
+      **沒有換掉 `cur.sub`**，而 `drawWaitOverlay` (a) 那張字卡的唯一來源
+      就是 `waitEngineBadge(w.sub)`。結果是黏土變成冷灰藍、
+      **「⚠ 他說的話是查表湊的」那一句不出現**——顏色變了而字沒出來。
+
+   先前那張退化截圖之所以是對的，是因為它用 CDP 探針**直接寫 `w.sub`**。
+   那就是「測試綠 ≠ 接上產品路徑」的標本，所以這一組掃的是產品那一條。
+   ⚠ `waitResolverTick` 在 LIVE 區段**外面**（它要 fetch），所以這裡掃原始碼，
+     行為面則用 LIVE 區段裡的 `waitEngineBadge` 直接驗兩種 sub 的結果。 */
+{
+  const ri = html.indexOf("function waitResolverTick()");
+  const rj = html.indexOf("function waitResolverStart()");
