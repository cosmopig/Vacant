{"schema": "twin.sidecar/1", "type": "twin_step", "ts_ms": 1791402941987, "cell_id": "tw-7e3c879707ba", "run_id": "8366b400369646e5b3c15047c851bfdb", "seq": 6, "step": "read", "path_kind": "ground:longtable", "bytes": null, "ok": false}
