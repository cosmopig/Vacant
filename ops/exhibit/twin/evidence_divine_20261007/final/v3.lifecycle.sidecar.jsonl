{"schema": "twin.sidecar/1", "type": "twin_step", "ts_ms": 1791396899236, "cell_id": "tw-4a8b7e297db3", "run_id": "031c471db9984a68811fd0a645821974", "seq": 4, "step": "read", "path_kind": "ground:easel", "bytes": 422, "ok": true}
