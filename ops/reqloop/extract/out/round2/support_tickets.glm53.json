    {
      "id": "R1",
      "quote": "只統計 `status` 為 `CLOSED` 的工單（`OPEN` 進行中工單不計入任何統計）。",
      "deliverable": "sla_report.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "input_csv": "tickets.csv",
        "group_by": [
          "priority"
        ],
        "exclude": [
          {
            "col": "status",
            "op": "ne",
            "value": "CLOSED"
          }
        ],
        "aggregates": [
          {
            "name": "ticket_count",
            "type": "count"
          }
        ]
      },
      "description": "依 priority 分組，僅統計 status 為 CLOSED 的工單數（ticket_count）。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
