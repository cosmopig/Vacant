          }
        ],
        "aggregates": [
          {
            "name": "avg_resolved_hours",
            "type": "mean",
            "col": "resolved_hours"
          }
        ]
      },
      "description": "各優先級結案工單 resolved_hours 平均值，小數點後 2 位。",
      "required": true,
