            "name": "student_count",
            "type": "count"
          },
          {
            "name": "passing_count",
            "type": "count_if",
            "expr": "total_score >= 60.0"
          },
          {
            "name": "pass_rate",
            "type": "ratio",
            "num": "passing_count",
            "den": "student_count",
            "round": 2
          },
          {
            "name": "average_score",
            "type": "mean",
            "col": "total_score",
            "round": 2
          }
        ]
