    {
      "id": "R3",
      "quote": "總評成績 `total_score = midterm_score × 0.4 + final_score × 0.6`；`total_score ≥ 60.0` 為及格。",
      "deliverable": "class_summary.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "group_by": "class_name",
        "aggregates": {
          "average_score": "mean(total_score)",
          "passing_count": "count(total_score >= 60.0)"
        },
        "input_csv": "grades.csv"
      },
      "description": "total_score 以 midterm_score×0.4 + final_score×0.6 計算，及格門檻為 total_score ≥ 60.0，分組聚合值須與重算一致。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R4",
      "quote": "產出 `class_summary.csv`，欄位：`class_name, student_count, passing_count, pass_rate, average_score`",
      "deliverable": "class_summary.csv",
      "verifier": "csv_structure",
      "kind": "explicit",
      "params": {
