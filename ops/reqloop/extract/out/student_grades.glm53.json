{
  "task_id": "student_grades",
  "items": [
    {
      "id": "req_class_summary_structure",
      "quote": "產出 `class_summary.csv`，欄位：`class_name, student_count, passing_count, pass_rate, average_score`",
      "deliverable": "class_summary.csv",
      "verifier": "table_structure",
      "kind": "explicit",
      "params": {
        "required_columns": [
          "class_name",
          "student_count",
          "passing_count",
          "pass_rate",
          "average_score"
        ]
      },
      "description": "class_summary.csv 必須存在，且含 class_name、student_count、passing_count、pass_rate、average_score 欄位。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "req_class_summary_aggregates",
      "quote": "總評成績 `total_score = midterm_score × 0.4 + final_score × 0.6`；`total_score ≥ 60.0` 為及格。",
      "deliverable": "class_summary.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "input_csv": "grades.csv",
        "group_by": [
          "class_name"
        ],
        "dedup_by": [
          "student_id"
        ],
        "exclude": [
          {
            "col": "status",
            "op": "ne",
            "value": "WITHDRAWN"
          }
        ],
        "compute": [
          {
            "name": "total_score",
            "expr": "midterm_score * 0.4 + final_score * 0.6"
          }
        ],
        "aggregates": [
          {
            "name": "student_count",
            "type": "count"
          },
          {
            "name": "passing_count",
            "type": "count_if",
            "expr": "total_score >= 60.0"
          },
          {
            "name": "pass_rate",
            "type": "mean",
            "expr": "total_score >= 60.0"
          },
          {
            "name": "average_score",
            "type": "mean",
            "col": "total_score"
          }
        ]
      },
      "description": "依 class_name 分組，排除 status 為 WITHDRAWN、同一 student_id 去重只留第一筆後，計算各班修課人數、及格人數（total_score ≥ 60.0）、及格率與 total_score 平均，與 class_summary.csv 重算比對。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "req_summary_md_metrics",
      "quote": "產出 `summary.md`，須明確載明「全年級及格率」（百分比，小數點後 2 位）與「全年級平均總評」（小數點後 2 位）。",
      "deliverable": "summary.md",
      "verifier": "summary_metrics_consistency",
      "kind": "explicit",
      "params": {
        "input_csv": "grades.csv",
        "metric_keywords": [
          "全年級及格率",
          "全年級平均總評"
        ]
      },
      "description": "summary.md 中「全年級及格率」與「全年級平均總評」的數字須與原始資料重算一致（排除 WITHDRAWN、student_id 去重、total_score = midterm_score × 0.4 + final_score × 0.6）。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    }
  ],
  "model": "glm53",
  "report": {
    "parse_error": null,
