      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R3",
      "quote": "同時需列出各月份淨銷售額前三名商品：`top_1_product`、`top_2_product`、`top_3_product`（請務必嚴格依該月份內之**淨銷售額**高低由大到小排序，不可依訂單筆數排序）。",
      "deliverable": "monthly_sales.csv",
      "verifier": "monthly_top_products",
      "kind": "explicit",
      "params": {
        "input_csv": "orders.csv",
        "top_n": 3,
        "exclude": [
          {
            "col": "status",
            "op": "eq",
            "value": "CANCELLED"
