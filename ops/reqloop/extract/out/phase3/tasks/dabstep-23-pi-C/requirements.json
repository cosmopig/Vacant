{
  "task_id": "dabstep-23-pi-C",
  "items": [
    {
      "id": "R1",
      "quote": "What is the fraud rate for in-person transactions for the year 2023?",
      "deliverable": "answer.txt",
      "verifier": "plain_recomputed",
      "kind": "explicit",
      "params": {
        "data_file": "data/payments.csv",
        "recompute": {
          "type": "cond_rate",
          "where": [
            {
              "col": "shopper_interaction",
              "op": "eq",
              "value": "POS"
            },
            {
              "col": "year",
              "op": "eq",
              "value": 2023
            }
          ],
          "num_where": [
            {
              "col": "has_fraudulent_dispute",
              "op": "eq",
              "value": true
            }
          ]
        }
      },
      "description": "以 payments.csv 重算 2023 年 POS（in-person）交易中 has_fraudulent_dispute 為 true 的比率，與 answer.txt 的數字比對。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R2",
      "quote": "Answer must be just a number.",
      "deliverable": "answer.txt",
      "verifier": "tag_format",
      "kind": "explicit",
      "params": {
        "tag": "answer",
        "value_type": "number"
      },
      "description": "answer.txt 內容必須是單一數字（一行純文字值）。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": true
    }
  ]
}