ry_code\":[\n            5411,\n            5412,\n            5499,\n            5912,\n            5812,\n            5813,\n            5911,\n            5983\n        ],\n        \"is_credit\":true,\n        \"aci\":[\n            \"C\",\n            \"A\"\n        ],\n        \"fixed_amount\":0.09,\n        \"rate\":73,\n        \"intracountry\":null\n    },\n    {\n        \"ID\":137,\n        \"card_scheme\":\"TransactPlus\",\n        \"account_type\":[\n            \"R\"\n        ],\n        \"capture_delay\":\">5\",\n        \"monthly_fraud_level\":null,\n        \"monthly_volume\":null,\n        \"merchant_category_code\":[\n            5411,\n            5412,\n            5499,\n            5912,\n            5812,\n            5813,\n            5911,\n            5983\n        ],\n        \"is_credit\":false,\n        \"aci\":[\n            \"E\"\n        ],\n        \"fixed_amount\":0.02,\n        \"rate\":48,\n        \"intracountry\":1.0\n    },\n    {\n        \"ID\":138,\n        \"card_scheme\":\"SwiftCharge\",\n        \"account_type\":[\n\n        ],\n        \"capture_delay\":null,\n        \"monthly_fraud_level\":null,\n        \"monthly_volume\":\"1m-5m\",\n        \"merchant_category_code\":[\n            5411,\n            5412,\n            5499,\n            5912,\n            5812,\n            5813,\n            5911,\n            5983\n        ],\n        \"is_credit\":true,\n        \"aci\":[\n            \"A\",\n            \"B\",\n            \"C\"\n        ],\n        \"fixed_amount\":0.08,\n        \"rate\":29,\n        \"intracountry\":null\n    },\n    {\n        \"ID\":139,\n        \"card_scheme\":\"TransactPlus\",\n        \"account_type\":[\n\n        ],\n        \"capture_delay\":\"3-5\",\n        \"monthly_fraud_level\":null,\n        \"monthly_volume\":null,\n        \"merchant_category_code\":[\n            8000,\n            8011,\n            8021,\n            8031,\n            8041,\n            7299,\n           