    {
      "id": "req-1",
      "quote": "`event_type` 不分大小寫（`CLICK`、`click`、`Click` 為同一類），輸出用 lower。",
      "deliverable": "event_stats.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "input_json": "events.json",
        "group_by": [
          "event_type"
        ],
        "group_normalize": {
          "event_type": {
            "lower": true
          }
        },
        "flatten": [
          {
            "path": "payload.duration_ms",
            "as": "duration_ms",
            "impute": 0
          }
        ],
        "aggregates": [
          {
            "name": "event_count",
            "type": "count"
          },
          {
            "name": "total_duration_ms",
            "type": "sum",
            "col": "duration_ms"
          }
        ]
      },
      "description": "event_type 不分大小寫並以 lower 輸出，分組計數與 duration_ms 加總需與原始資料重算一致。",
