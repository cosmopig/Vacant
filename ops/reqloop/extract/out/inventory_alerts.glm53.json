      "quote": "排除 `supplier_status` 為 `DISCONTINUED` 的停產項目。",
      "deliverable": "restock_alerts.csv",
      "verifier": "rowset_filter",
      "kind": "explicit",
      "params": {
        "input_csv": "inventory.csv",
        "identity": [
          "item_id"
