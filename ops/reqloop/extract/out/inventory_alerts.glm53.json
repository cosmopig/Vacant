    {
      "id": "R4",
      "quote": "產出 `restock_alerts.csv`，欄位：`item_id, item_name, current_stock, safety_stock, restock_needed, estimated_cost`",
      "deliverable": "restock_alerts.csv",
      "verifier": "csv_structure",
      "kind": "explicit",
      "params": {
        "required_columns": [
          "item_id",
          "item_name",
          "current_stock",
          "safety_stock",
          "restock_needed",
          "estimated_cost"
        ]
      },
      "description": "交付檔 restock_alerts.csv 必須存在且含指定六個欄位。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R5",
      "quote": "`restock_needed = safety_stock - current_stock`",
      "deliverable": "restock_alerts.csv",
      "verifier": "rowset_filter",
      "kind": "explicit",
      "params": {
        "data_file": "inventory.csv",
        "exclude": {
          "supplier_status": [
            "DISCONTINUED"
          ]
        },
        "dedup": {
          "key": "item_id",
          "keep": "first"
        },
        "filter": "current_stock < safety_stock",
        "recompute_columns": {
          "restock_needed": "safety_stock - current_stock"
        }
      },
      "description": "restock_needed 欄值須等於 safety_stock - current_stock，與重算逐列比對。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R6",
      "quote": "`estimated_cost = restock_needed × unit_cost`（小數點後 2 位）",
      "deliverable": "restock_alerts.csv",
      "verifier": "rowset_filter",
      "kind": "explicit",
      "params": {
        "data_file": "inventory.csv",
        "exclude": {
          "supplier_status": [
            "DISCONTINUED"
          ]
        },
        "dedup": {
          "key": "item_id",
          "keep": "first"
        },
        "filter": "current_stock < safety_stock",
        "recompute_columns": {
