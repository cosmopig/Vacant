    {
      "id": "R3",
      "quote": "選出庫存不足品項：`current_stock < safety_stock`（等於安全量者不需補貨）。",
      "deliverable": "restock_alerts.csv",
      "verifier": "rowset_filter",
      "kind": "explicit",
      "params": {
        "data_file": "inventory.csv",
        "exclude": {
          "supplier_status": [
            "DISCONTINUED"
          ]
        },
        "dedup": {
          "key": "item_id",
