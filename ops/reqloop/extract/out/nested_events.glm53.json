{
  "task_id": "nested_events",
  "items": [
    {
      "id": "R1",
      "quote": "`event_type` 不分大小寫（`CLICK`、`click`、`Click` 為同一類），輸出用 lower。",
      "deliverable": "event_stats.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "group_by": "event_type_lower",
        "aggregates": [
          {
            "column": "event_type",
            "op": "lowercase_group"
          },
          {
            "column": "event_count",
            "op": "count"
          },
          {
            "column": "total_duration_ms",
            "op": "sum",
            "field": "payload.duration_ms",
            "missing_as": 0
          }
        ],
        "input_json": "events.json"
      },
      "description": "event_type 需先轉小寫再分組，CLICK/click/Click 視為同一類，輸出為小寫。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R2",
      "quote": "`payload.duration_ms` 缺失以 0 計（該事件**仍計入** event_count）；無 payload 的事件也仍計數。",
      "deliverable": "event_stats.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "group_by": "event_type_lower",
        "aggregates": [
          {
            "column": "event_count",
            "op": "count",
            "note": "含 payload 缺失與 duration_ms 缺失事件"
          },
          {
            "column": "total_duration_ms",
            "op": "sum",
            "field": "payload.duration_ms",
            "missing_as": 0
          }
        ],
        "input_json": "events.json"
      },
      "description": "duration_ms 或整個 payload 缺失時，事件仍計入 event_count，duration 以 0 計入總和。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R3",
      "quote": "產出 `event_stats.csv`，欄位：`event_type, event_count, total_duration_ms`",
      "deliverable": "event_stats.csv",
      "verifier": "csv_structure",
      "kind": "explicit",
      "params": {
        "required_columns": [
          "event_type",
          "event_count",
          "total_duration_ms"
        ]
      },
      "description": "交付檔 event_stats.csv 必須存在且含三個指定欄位。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R4",
      "quote": "`total_duration_ms` = 該類型 `duration_ms` 加總（缺失以 0 計）。",
      "deliverable": "event_stats.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "group_by": "event_type_lower",
        "aggregates": [
          {
            "column": "total_duration_ms",
            "op": "sum",
            "field": "payload.duration_ms",
            "missing_as": 0
          }
        ],
        "input_json": "events.json"
      },
      "description": "各類型 total_duration_ms 為該類（不分大小寫）所有事件 duration_ms 加總，缺失以 0 計。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R5",
      "quote": "產出 `summary.md`，須明確載明「事件總數」（全部事件筆數，精確數值）與「總時長」（ms）。",
      "deliverable": "summary.md",
      "verifier": "summary_numbers",
      "kind": "explicit",
      "params": {
        "numbers": [
          {
            "label": "事件總數",
            "recompute": "count_all_events"
          },
          {
            "label": "總時長",
            "recompute": "sum(payload.duration_ms, missing_as=0)",
            "unit": "ms"
          }
        ],
        "input_json": "events.json"
      },
      "description": "summary.md 須載明事件總數（全部事件筆數）與總時長（ms），數值須與原始資料重算一致。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    }
