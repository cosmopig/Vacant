  "items": [
    {
      "id": "R1",
      "quote": "只統計 `status` 為 `CLOSED` 的工單（`OPEN` 進行中工單不計入任何統計）。",
      "deliverable": "sla_report.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "input_csv": "tickets.csv",
        "group_by": [
          "priority"
        ],
        "exclude": [
          {
            "col": "status",
            "op": "ne",
            "value": "CLOSED"
          }
        ],
        "aggregates": [
          {
            "name": "ticket_count",
            "type": "count"
          },
          {
            "name": "avg_resolved_hours",
            "type": "mean",
            "col": "resolved_hours"
          },
          {
            "name": "sla_met_count",
            "type": "count_if",
            "expr": "resolved_hours <= sla_target_hours"
          },
          {
            "name": "sla_rate",
            "type": "ratio",
            "num": "sla_met_count",
            "den": "ticket_count",
            "round": 4
          },
          {
            "name": "worst_hours",
            "type": "max",
            "col": "resolved_hours"
          }
        ]
      },
      "description": "僅統計 status 為 CLOSED 的工單，依 priority 分組計算各聚合值。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": true
    },
