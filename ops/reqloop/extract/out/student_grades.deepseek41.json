    {
      "id": "R1",
      "quote": "排除 `status` 為 `WITHDRAWN` 的休退學記錄。",
      "deliverable": "class_summary.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "input_csv": "grades.csv",
        "group_by": [
          "class_name"
        ],
        "exclude": [
          {
            "col": "status",
            "op": "eq",
            "value": "WITHDRAWN"
          }
        ],
        "dedup_by": "student_id",
        "compute": [
          {
            "name": "total_score",
            "expr": "midterm_score * 0.4 + final_score * 0.6"
          }
        ],
        "aggregates": [
          {
            "name": "student_count",
            "type": "count"
          },
          {
            "name": "passing_count",
            "type": "count_if",
            "expr": "total_score >= 60.0"
          },
          {
            "name": "pass_rate",
            "type": "ratio",
            "num": "passing_count",
            "den": "student_count",
            "round": 2
          },
          {
            "name": "average_score",
            "type": "mean",
            "col": "total_score",
            "round": 2
          }
        ]
      },
      "description": "各班修課人數、及格人數、及格率與平均總評，排除 WITHDRAWN、同 student_id 只留第一筆。",
