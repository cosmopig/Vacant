{
  "task_id": "support_tickets",
  "items": [
    {
      "id": "R1",
      "quote": "只統計 `status` 為 `CLOSED` 的工單（`OPEN` 進行中工單不計入任何統計）",
      "deliverable": "sla_report.csv",
      "verifier": "rowset_filter",
      "kind": "explicit",
      "params": {
        "identity": "ticket_id",
        "input_csv": "tickets.csv",
        "filter": "status == CLOSED"
      },
      "description": "所有統計僅納入 status 為 CLOSED 的工單，OPEN 工單不得計入任何統計。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R2",
      "quote": "依 `priority` 分組，產出 `sla_report.csv`，欄位：`priority, ticket_count, avg_resolved_hours, sla_met_count, sla_rate, worst_hours`",
      "deliverable": "sla_report.csv",
      "verifier": "csv_structure",
      "kind": "explicit",
      "params": {
        "required_columns": [
          "priority",
          "ticket_count",
          "avg_resolved_hours",
          "sla_met_count",
          "sla_rate",
          "worst_hours"
        ]
      },
      "description": "sla_report.csv 必須存在且含指定欄位。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R3",
      "quote": "`ticket_count`＝該優先級結案工單數",
      "deliverable": "sla_report.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "group_by": "priority",
        "aggregates": [
          {
            "column": "ticket_id",
            "op": "count",
            "as": "ticket_count",
            "filter": "status == CLOSED"
          }
        ],
        "input_csv": "tickets.csv"
      },
      "description": "各優先級的 ticket_count 須等於該優先級 CLOSED 工單數。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R4",
      "quote": "`avg_resolved_hours`＝`resolved_hours` 平均值（小數點後 2 位）",
      "deliverable": "sla_report.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "group_by": "priority",
        "aggregates": [
          {
            "column": "resolved_hours",
            "op": "mean",
            "as": "avg_resolved_hours",
            "round": 2,
            "filter": "status == CLOSED"
          }
        ],
        "input_csv": "tickets.csv"
      },
      "description": "各優先級 avg_resolved_hours 為 resolved_hours 平均值，四捨五入至小數點後 2 位。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R5",
      "quote": "`sla_met_count`＝`resolved_hours <= sla_target_hours` 的工單數（等於目標者視為達標）",
      "deliverable": "sla_report.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "group_by": "priority",
        "aggregates": [
          {
            "op": "count_if",
            "condition": "resolved_hours <= sla_target_hours",
            "as": "sla_met_count",
            "filter": "status == CLOSED"
          }
        ],
        "input_csv": "tickets.csv"
      },
      "description": "各優先級 sla_met_count 為 resolved_hours <= sla_target_hours 的 CLOSED 工單數（含等於目標者）。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R6",
      "quote": "`sla_rate`＝sla_met_count ÷ ticket_count（小數點後 4 位）",
      "deliverable": "sla_report.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "group_by": "priority",
        "aggregates": [
          {
            "op": "ratio",
            "numerator": "sla_met_count",
            "denominator": "ticket_count",
            "as": "sla_rate",
            "round": 4,
            "filter": "status == CLOSED"
          }
        ],
        "input_csv": "tickets.csv"
      },
      "description": "各優先級 sla_rate 等於 sla_met_count ÷ ticket_count，取小數點後 4 位。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R7",
      "quote": "`worst_hours`＝該優先級 `resolved_hours` 的最大值",
      "deliverable": "sla_report.csv",
      "verifier": "group_aggregate",
      "kind": "explicit",
      "params": {
        "group_by": "priority",
        "aggregates": [
          {
            "column": "resolved_hours",
            "op": "max",
            "as": "worst_hours",
            "filter": "status == CLOSED"
          }
        ],
        "input_csv": "tickets.csv"
      },
      "description": "各優先級 worst_hours 為該組 resolved_hours 最大值。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    },
    {
      "id": "R8",
      "quote": "產出 `summary.md`，須明確載明「結案工單總數」、「整體 SLA 達標率（百分數，小數點後 2 位）」與「最長處理時數」（精確數值）",
      "deliverable": "summary.md",
      "verifier": "summary_numbers",
      "kind": "explicit",
      "params": {
        "numbers": [
          {
            "name": "結案工單總數",
            "recompute": "count of status == CLOSED"
          },
          {
            "name": "整體 SLA 達標率",
            "recompute": "count(resolved_hours <= sla_target_hours and status == CLOSED) / count(status == CLOSED) * 100, rounded to 2 decimals, percent format"
          },
          {
            "name": "最長處理時數",
            "recompute": "max(resolved_hours) among status == CLOSED"
          }
        ],
        "input_csv": "tickets.csv"
      },
      "description": "summary.md 須載明三項指標：結案工單總數、整體 SLA 達標率（百分數、小數點後 2 位）、最長處理時數（精確數值），且數字與從 tickets.csv 重算一致。",
      "required": true,
      "authority": "client",
      "hidden": false,
      "unverified": false
    }
  ],
