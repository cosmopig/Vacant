+# ══ 對抗審查（2026-09-26，10 條重現）的回歸：每一條在修之前都會失敗 ══════════════════════════
+
+class Claude:
+    """Claude Code 的掛鉤格式：失敗的殼層指令走 `PostToolUseFailure`，`error` 的第一行是 `Exit code N`。"""
+
+    def __init__(self, p: pathlib.Path, sid: str = "C"):
+        self.p, self.sid, self.n = p, sid, 0
+
+    def _base(self):
+        return {"session_id": self.sid, "cwd": str(self.p)}
+
+    def ask(self, text=ASK):
+        hook.handle("claude", "UserPromptSubmit", {**self._base(), "prompt": text})
+
+    def write(self, rel, content):
+        self.n += 1
+        pre = {**self._base(), "tool_name": "Write", "tool_use_id": f"w{self.n}",
+               "tool_input": {"file_path": str(self.p / rel), "content": content}}
+        hook.handle("claude", "PreToolUse", pre)
+        (self.p / rel).parent.mkdir(parents=True, exist_ok=True)
+        (self.p / rel).write_text(content)
+        hook.handle("claude", "PostToolUse", {**pre, "tool_response": {}})
+
+    def bash(self, cmd, stdout="", *, error=None):
+        self.n += 1
+        pre = {**self._base(), "tool_name": "Bash", "tool_use_id": f"b{self.n}", "tool_input": {"command": cmd}}
+        hook.handle("claude", "PreToolUse", pre)
+        if error is not None:
+            hook.handle("claude", "PostToolUseFailure", {**pre, "error": error})
+        else:
+            hook.handle("claude", "PostToolUse", {**pre, "tool_response": {"stdout": stdout, "stderr": ""}})
+
+    def stop(self, final="Done."):
+        out, err, code = hook.handle("claude", "Stop", {**self._base(), "hook_event_name": "Stop",
+                                                         "stop_hook_active": False,
+                                                         "last_assistant_message": final})
+        assert code == 0 and err == ""
+        return json.loads(out) if out else {}
+
+
+def _blocked(d) -> bool:
+    return d.get("decision") == "block"
+
+
+# ── #1 引號、heredoc、只是提到測試指令的那一段 ──
