+    一起拿掉；引號外、字開頭的 `#` 到行尾是註解。引號沒配對回 `None`。"""
+    out: list[tuple[str, str]] = []
+    buf: list[str] = []
+    started = drop = False
+    i, n = 0, len(cmd)
+
+    def flush() -> None:
+        nonlocal buf, started, drop
+        if started:
+            if drop:
+                drop = False
+            else:
