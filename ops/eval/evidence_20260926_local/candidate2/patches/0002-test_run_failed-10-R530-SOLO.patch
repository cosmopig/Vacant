+def _drop_heredocs(cmd: str) -> str:
+    """拿掉 heredoc 的內文（`cat > f <<'EOF'` 之後到 `EOF` 那一行）：內文是資料，不是要執行的指令。
+    `<<<` 不是 heredoc。結束行沒找到：之後全部當內文。"""
+    out: list[str] = []
+    pending: list[str] = []
+    for ln in cmd.split("\n"):
+        if pending:
+            if ln.strip() == pending[0]:
+                pending.pop(0)
+            continue
+        out.append(ln)
+        pending += [m.group(3) for m in _HEREDOC.finditer(ln)]
