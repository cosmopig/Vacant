+    'sed -i "s|pytest|python -m pytest|" Makefile',
+    "cat > README.md <<'EOF'\n# Usage\n\nRun the tests:\n\n    pytest -q\nEOF",
+    'git commit -m "Fix parsing\n\nmake test now passes"',
+    'git commit -m "Fix parsing\n\npytest -q passes now"',
+    'echo "run pytest | tee log"',
+    "printf 'pytest -q\\n' >> notes.txt",
+    "npm install -D jest",
+    "find . -name '*.cfg' | xargs grep -l pytest",
+])
+def test_f1_a_failing_command_that_only_mentions_a_runner_is_not_sent_back(proj, cmd):
+    """grep 找不到（結束碼 1）、sed、heredoc、commit 訊息裡的 `pytest`／`make test` 不是在跑測試。"""
+    c = Claude(proj)
+    c.ask("Which test runner does this project use? Tell me.")
+    c.bash(cmd, error="Exit code 1")
+    d = c.stop("This project has no JavaScript test runner configured.")
+    assert not _blocked(d), d
+    assert "Test or build runs" not in _note(proj) and "test_run" not in _data(proj)
+
+
+@pytest.mark.parametrize("mention", ['grep -c "pytest|tox" setup.cfg', "sed -n 's|pytest|x|p' tox.ini",
