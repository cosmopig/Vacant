+class RunnerRun(NamedTuple):
+    """一個殼層指令裡執行的測試／build（`runner_run`）。"""
+    key: str            # 哪一個測試指令：`pytest`、`unittest`、`npm test`、`npm build`（`finding_id` 用）
+    reliable: bool      # 整個指令的結束碼就是它的（不在管線中間、後面沒有別的指令、不是條件）
+    py: bool            # pytest／unittest：結束碼 5＝沒有收集到任何測試
+
+
+def runner_run(cmd: str) -> RunnerRun | None:
+    """這個殼層指令**執行**了一個標準測試／build 指令嗎？回 `None`＝沒有。
+
+    一段指令（引號外的 `;`、`&&`、`||`、`|`、`&`、換行、括號切開；heredoc 的內文先拿掉）去掉開頭的環境變數、
+    `sudo`／`env`／`timeout N`、`uv run [選項]`、`npx`…、`python -m` 之後，`RUNNERS` 在那一段找得到、而且那一段的
+    指令不是只提到它的（`MENTION_CMDS`、`pip install pytest`、`npm install jest`、`python -c "import unittest"`）
+    才算。`bash -c '…'` 看引號裡面。引號沒配對＝剖析不了＝不算（寧可漏）。"""
+    return _runner_in(cmd or "", 0)
+
+
+def _runner_in(cmd: str, depth: int) -> RunnerRun | None:
+    toks = _shell_tokens(_drop_heredocs(cmd))
+    if toks is None:
+        return None
+    segs: list[tuple[list[str], str]] = []
+    cur: list[str] = []
+    for kind, t in toks:
+        if kind == "w":
+            cur.append(t)
+        else:
+            segs.append((cur, t))
+            cur = []
+    segs.append((cur, ""))
+    found = [(i, r) for i, (words, _op) in enumerate(segs) if words
+             for r in [_segment_runner(words, depth)] if r is not None]
+    if not found:
+        return None
+    pipefail = bool(_PIPEFAIL.search(cmd))
+    reliable = all(r.reliable and _status_is_its_own(segs, i, pipefail) for i, r in found)
+    last = found[-1][1]
+    return RunnerRun(last.key, reliable, last.py)
+
+
+def _status_is_its_own(segs: list[tuple[list[str], str]], i: int, pipefail: bool) -> bool:
+    """第 i 段的結束碼就是整個指令的結束碼：它後面只接管線（而且有 `set -o pipefail`）或什麼都沒有，
+    也沒有被 `&` 丟到背景。括號與 `}`／`fi`／`done` 這種只收尾的段落不算。"""
+    later = [k for k in range(i + 1, len(segs))
+             if segs[k][0] and not (len(segs[k][0]) == 1 and segs[k][0][0] in _CLOSERS)]
+    end = later[-1] if later else len(segs)
+    between = [segs[k][1] for k in range(i, end) if segs[k][1] not in ("(", ")")]
+    trailing = [segs[k][1] for k in range(end, len(segs))]
+    if "&" in trailing or (not later and "&" in between):
+        return False
+    if later:
+        return pipefail and all(op in ("|", "|&") for op in between)
+    return True
+
+
+def _segment_runner(words: list[str], depth: int) -> RunnerRun | None:
+    w, cond = _unwrap(words)
+    if not w:
+        return None
+    base = w[0].rsplit("/", 1)[-1]
+    if base in _SHELLS:
+        for j in range(1, len(w)):
+            if re.fullmatch(r"-[A-Za-z]*c[A-Za-z]*", w[j]):
+                if depth >= 2 or j + 1 >= len(w):
+                    return None
+                inner = _runner_in(w[j + 1], depth + 1)
+                return inner._replace(reliable=inner.reliable and not cond) if inner else None
+            if not w[j].startswith("-"):
+                break
+    if base in MENTION_CMDS:
+        return None
+    rest = w[1:]
+    if re.fullmatch(r"(?:python|pypy)[\d.]*|py", base):
+        j = 0
+        while j < len(rest) and rest[j].startswith("-"):
+            opt = rest[j]
+            if opt == "-c":
+                return None                       # 一段程式碼（`python -c "import unittest"`），不是測試指令
+            if opt == "-m" or (opt.startswith("-m") and len(opt) > 2):
+                mod = opt[2:] if len(opt) > 2 else (rest[j + 1] if j + 1 < len(rest) else "")
+                rest = rest[j + (1 if len(opt) > 2 else 2):]
+                base = mod
+                break
+            j += 2 if opt in ("-X", "-W") else 1
+    if base in PKG_CMDS or base in ("pip", "pip3"):
+        verb = next((x for x in rest if not x.startswith("-")), "")
+        if verb in PKG_VERBS:
