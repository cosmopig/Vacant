+    m = RUNNERS.search(" ".join([base, *rest]))
+    if not m:
+        return None
+    key = re.sub(r"\s+run(?=\s)", "", m.group(0))
+    key = re.sub(r"^python3? -m ", "", key)
+    return RunnerRun(key, not cond, key in ("pytest", "unittest"))
+
+
+def _unwrap(words: list[str]) -> tuple[list[str], bool]:
+    """去掉一段指令開頭不是指令本身的東西：環境變數、條件關鍵字、`sudo`／`env`／`timeout N`／`nice`、
+    `uv run [選項]`、`npx`、`pnpm exec`。回 `(剩下的字, 有沒有條件或否定)`。"""
+    w, cond = list(words), False
+    for _ in range(12):
+        if not w:
+            break
+        h = w[0]
+        base = h.rsplit("/", 1)[-1]
+        if h in _COND:
+            cond, w = True, w[1:]
