   "name": "N01 curl --noproxy direct https wikipedia",
   "cmd": "curl -sS -m 8 --noproxy '*' https://en.wikipedia.org/wiki/Main_Page -o /dev/null -w '%{http_code}'",
   "expect": "fail",
   "rc": 6,
   "out": "000curl: (6) Could not resolve host: en.wikipedia.org\n",
   "pass": true
  },
  {
   "name": "N02 python urllib direct (ignore proxy env)",
   "cmd": "python: import urllib.request as u; u.build_opener(u.ProxyHandler({})).open('https://en.wikipedia.org/', timeout=8)",
   "expect": "fail",
   "rc": 1,
   "out": "URLError: <urlopen error [Errno -3] Temporary failure in name resolution>",
   "pass": true
  },
  {
   "name": "N03 node fetch (node ignores proxy env)",
