```python
def remove_repeats(input_list):
    seen = set()
    result = []
    for item in input_list:
        if item not in seen:
            result.append(item)
            seen.add(item)
    return result

# Example usage:
if __name__ == "__main__":
    test_list = [1, 2, 3, 2, 4, 1, 5]
    print(remove_repeats(test_list))  # Expected output: [1, 2, 3, 4, 5]
```
