def beautifulSplits(nums):
    n = len(nums)
    if n < 3: return 0
    
    # Rolling hash setup
    P = 101
    MOD = 10**9 + 7 # Or a larger prime/double hash to avoid collisions
    
    h = [0] * (n + 1)
    p_pow = [1] * (n + 1)
    for i in range(n):
        h[i+1] = (h[i] * P + nums[i]) % MOD
        p_pow[i+1] = (p_pow[i] * P) % MOD
        
    def get_hash(l, r): # [l, r)
        return (h[r] - h[l] * p_pow[r-l]) % MOD

    count = 0
    # Precompute Condition 1: nums[0:i] == nums[i:2*i]
    cond1 = [False] * (n + 1)
    for i in range(1, n // 2 + 1):
        if get_hash(0, i) == get_hash(i, 2*i):
            cond1[i] = True

    for i in range(1, n):
