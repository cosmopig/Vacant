def beautifulSplits(nums):
    n = len(nums)
    count = 0
    # Precompute Condition 1 for all i
    cond1 = [False] * (n + 1)
    for i in range(1, n // 2 + 1):
        if nums[0:i] == nums[i:2*i]:
            cond1[i] = True

    for i in range(1, n):
        # We need j such that i < j < n
        # and (j >= 2*i and cond1[i]) OR (n-j >= j-i and nums[i:j] == nums[j:2*j-i])
        for j in range(i + 1, n):
            l1 = i
            l2 = j - i
            l3 = n - j
            
            if (l2 >= l1 and cond1[i]) or (l3 >= l2 and nums[i:j] == nums[j:j+l2]):
                count += 1
    return count
```

