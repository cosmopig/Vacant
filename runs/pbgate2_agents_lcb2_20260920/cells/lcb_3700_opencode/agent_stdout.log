```python
from typing import List

def subsequencesWithMiddleMode(nums: List[int]) -> int:
    n = len(nums)
    MOD = 10**9 + 7
    ans = 0
    
    # Precompute C_L, N_L, SumPairsL for each i
    C_L = [0] * n
    N_L = [0] * n
    SumPairsL = [0] * n
    
    left_counts = {}
    current_sum_pairs = 0
    for i in range(n):
        c = nums[i]
        C_L[i] = left_counts.get(c, 0)
        N_L[i] = i
        SumPairsL[i] = current_sum_pairs
        
        # Update for next iteration
        cnt = left_counts.get(c, 0)
        current_sum_pairs += cnt
        left_counts[c] = cnt + 1
        
    # Precompute C_R, N_R, SumPairsR for each i
    C_R = [0] * n
    N_R = [0] * n
    SumPairsR = [0] * n
    
    right_counts = {}
    current_sum_pairs = 0
    for i in range(n - 1, -1, -1):
        c = nums[i]
        C_R[i] = right_counts.get(c, 0)
        N_R[i] = n - 1 - i
        SumPairsR[i] = current_sum_pairs
        
        # Update for next iteration
        cnt = right_counts.get(c, 0)
        current_sum_pairs += cnt
        right_counts[c] = cnt + 1

    for i in range(n):
        c = nums[i]
        cl = C_L[i]
        nl = N_L[i]
        cr = C_R[i]
        nr = N_R[i]
        spl = SumPairsL[i]
        spr = SumPairsR[i]
        
        # f(c) = 5: nL=2, nR=2
        # Ways: comb(cl, 2) * comb(cr, 2)
        ways_f5 = (cl * (cl - 1) // 2) * (cr * (cr - 1) // 2)
        ans = (ans + ways_f5) % MOD
        
        # f(c) = 4: nL=2, nR=1 OR nL=1, nR=2
        # Subcase 1: nL=2, nR=1. One from R is x != c.
        ways_f4a = (cl * (cl - 1) // 2) * cr * (nr - cr)
        # Subcase 2: nL=1, nR=2. One from L is x != c.
        ways_f4b = cl * (nl - cl) * (cr * (cr - 1) // 2)
        ans = (ans + ways_f4a + ways_f4b) % MOD
        
        # f(c) = 3: nL=2, nR=0 OR nL=1, nR=1 OR nL=0, nR=2
        # Subcase 1: nL=2, nR=0. Two from R are x, y != c.
        ways_f3a = (cl * (cl - 1) // 2) * ((nr - cr) * (nr - cr - 1) // 2)
        # Subcase 2: nL=1, nR=1. One from L is x != c, one from R is y != c.
        ways_f3b = cl * (nl - cl) * cr * (nr - cr)
        # Subcase 3: nL=0, nR=2. Two from L are x, y != c.
        ways_f3c = ((nl - cl) * (nl - cl - 1) // 2) * (cr * (cr - 1) // 2)
        ans = (ans + ways_f3a + ways_f3b + ways_f3c) % MOD
        
        # f(c) = 2: nL=1, nR=0 OR nL=0, nR=1
        # Subcase 1: nL=1, nR=0. One from L is c, two from R are y, z != c and distinct.
        # Ways to choose 2 indices from R \ {c} with distinct values:
        # comb(nr-cr, 2) - (SumPairsR - comb(cr, 2))
        distinct_r = ((nr - cr) * (nr - cr - 1) // 2) - (spr - (cr * (cr - 1) // 2))
        ways_f2a = cl * distinct_r
        # Subcase 2: nL=0, nR=1. Two from L are x, y != c and distinct, one from R is c.
        distinct_l = ((nl - cl) * (nl - cl - 1) // 2) - (spl - (cl * (cl - 1) // 2))
        ways_f2b = distinct_l * cr
        ans = (ans + ways_f2a + ways_f2b) % MOD
        
    return ans

```
