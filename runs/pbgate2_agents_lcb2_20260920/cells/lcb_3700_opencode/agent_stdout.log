```python
from typing import List

def subsequencesWithMiddleMode(nums: List[int]) -> int:
    n = len(nums)
    MOD = 10**9 + 7
    ans = 0
    distinct_values = sorted(list(set(nums)))
    val_to_idx = {v: i for i, v in enumerate(distinct_values)}
    num_distinct = len(distinct_values)
    
    # Precompute counts of each distinct value in prefix and suffix
    # count[i][j] is count of distinct_values[j] in nums[:i]
    prefix_counts = [[0] * num_distinct for _ in range(n + 1)]
    for i in range(n):
        for j in range(num_distinct):
            prefix_counts[i+1][j] = prefix_counts[i][j]
        prefix_counts[i+1][val_to_idx[nums[i]]] += 1
        
    suffix_counts = [[0] * num_distinct for _ in range(n + 1)]
    for i in range(n - 1, -1, -1):
        for j in range(num_distinct):
            suffix_counts[i][j] = suffix_counts[i+1][j]
        suffix_counts[i][val_to_idx[nums[i]]] += 1

    for i in range(n):
        c = nums[i]
        c_idx = val_to_idx[c]
        
        # Counts in L (0 to i-1) and R (i+1 to n-1)
        cl_counts = prefix_counts[i]
        cr_counts = suffix_counts[i+1]
        
        nl = i
        nr = n - 1 - i
        cl = cl_counts[c_idx]
        cr = cr_counts[c_idx]
        
        # S and Q for v != c
        sl = 0
        ql = 0
        sr = 0
        qr = 0
        for j in range(num_distinct):
            if j == c_idx: continue
            countL = cl_counts[j]
            countR = cr_counts[j]
            sl += countL
            ql += countL * countL
            sr += countR
            qr += countR * countR
            
        # f(c) = 5: nL=2, nR=2
        ways_f5 = (cl * (cl - 1) // 2) * (cr * (cr - 1) // 2)
        ans = (ans + ways_f5) % MOD
        
        # f(c) = 4: nL=2, nR=1 OR nL=1, nR=2
        ways_f4a = (cl * (cl - 1) // 2) * cr * (nr - cr)
        ways_f4b = cl * (nl - cl) * (cr * (cr - 1) // 2)
        ans = (ans + ways_f4a + ways_f4b) % MOD
        
        # f(c) = 3: nL=2, nR=0 OR nL=1, nR=1 OR nL=0, nR=2
        ways_f3a = (cl * (cl - 1) // 2) * ((nr - cr) * (nr - cr - 1) // 2)
        ways_f3b = cl * (nl - cl) * cr * (nr - cr)
        ways_f3c = ((nl - cl) * (nl - cl - 1) // 2) * (cr * (cr - 1) // 2)
        ans = (ans + ways_f3a + ways_f3b + ways_f3c) % MOD
        
        # f(c) = 2: nL=1, nR=0 OR nL=0, nR=1
        # Case 1: one c from L, two distinct values {y, z} from R \ {c}
        ways_f2a = 0
        for j in range(num_distinct):
            if j == c_idx: continue
            countR = cr_counts[j]
            # Ways to choose 2 distinct values from U_R \ {x} where x is the value from L
            # Wait, this loop is over all possible values of x.
            # But we need to sum over all x in U_L.
            pass
        
        # Let's use the optimized formula:
        # Case 1: one c from L, two distinct {y, z} from R \ {c} s.t. y,z != x (where x is value from L)
        # Sum over x in U_L of count(x, L) * [ways to choose {y, z} from U_R \ {x}]
        # ways = sum_{x in U_L} count(x, L) * ((sr - count(x, R))^2 - (qr - count(x, R)^2)) / 2
        
        ways_f2a = 0
        for j in range(num_distinct):
            if j == c_idx: continue
            countL = cl_counts[j]
            countR = cr_counts[j]
            term = ((sr - countR)**2 - (qr - countR**2)) // 2
            ways_f2a += countL * term
        ans = (ans + ways_f2a) % MOD
        
        # Case 2: two distinct {x, y} from L \ {c}, one c from R
        ways_f2b = 0
        for j in range(num_distinct):
            if j == c_idx: continue
            countR = cr_counts[j]
            term = ((sl - countL)**2 - (ql - countL**2)) // 2 # wait, this is wrong.
            # It should be sum over x in U_R of count(x, R) * [ways to choose {y, z} from U_L \ {x}]
            pass
        
        # Let's re-write Case 2 correctly:
        # Sum over x in U_R of count(x, R) * ((sl - count(x, L))^2 - (ql - count(x, L)^2)) / 2
        ways_f2b = 0
        for j in range(num_distinct):
            if j == c_idx: continue
            countR = cr_counts[j]
            countL = cl_counts[j]
            term = ((sl - countL)**2 - (ql - countL**2)) // 2
            ways_f2b += countR * term
        ans = (ans + ways_f2b) % MOD

    return ans
