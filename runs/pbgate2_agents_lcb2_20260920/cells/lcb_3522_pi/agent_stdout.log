from typing import List

def resultsArray(nums: List[int], k: int) -> List[int]:
    n = len(nums)
    results = []
    for i in range(n - k + 1):
        is_consecutive_sorted = True
        # Check if nums[i...i+k-1] is consecutive and sorted ascending
        # This means nums[i+j] == nums[i] + j for all j from 0 to k-1
        for j in range(1, k):
            if nums[i + j] != nums[i] + j:
                is_consecutive_sorted = False
                break
        
        if is_consecutive_sorted:
            results.append(nums[i + k - 1])
        else:
            results.append(-1)
    return results
```

