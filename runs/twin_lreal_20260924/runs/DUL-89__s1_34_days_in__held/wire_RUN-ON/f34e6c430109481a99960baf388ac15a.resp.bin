data: {"id":"chatcmpl-2206q9glpswqc45t6c0kk9","object":"chat.completion.chunk","created":1790241083,"model":"gemma-4-12b-it-qat","system_fingerprint":"gemma-4-12b-it-qat","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"type":"function","function":{"arguments":"{\"content\":\"import sys\\n\\ndef solve():\\n    line = sys.stdin.read().split()\\n    if not line:\\n        return\\n    year = int(line[0])\\n    month = int(line[1])\\n    \\n    # Days in each month for a non-leap year\\n    days_in_months = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\\n    \\n    # Check for leap year\\n    is_leap = (year % 4 == 0 and (year % 100 != 0 or year % 400 == 0))\\n    \\n    if is_leap:\\n        days_in_months[1] = 29\\n        \\n    print(days_in_months[month - 1])\\n\\nif __name__ == \\\"__main__\\\":\\n    solve()\\n\",\"path\":\"solution.py\"}"}}]},"logprobs":null,"finish_reason":null}]}

